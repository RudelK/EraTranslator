<Window x:Class="EraTranslator.UserDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="사용자 사전"
        Width="760"
        Height="560"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="전역 사전">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="모든 프로젝트에 공통으로 적용됩니다."
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,10"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="{Binding GlobalDictionaryPath}"
                               TextWrapping="Wrap" />

                    <DockPanel Grid.Row="2">
                        <StackPanel DockPanel.Dock="Top"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                            <Button Width="84"
                                    Margin="0,0,8,0"
                                    Click="AddGlobalEntry_Click"
                                    Content="추가" />
                            <Button Width="84"
                                    Click="RemoveGlobalEntry_Click"
                                    Content="삭제" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding GlobalEntries}"
                                  SelectedItem="{Binding SelectedGlobalEntry, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Width="64"
                                                        Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                        Header="사용" />
                                <DataGridTextColumn Width="*"
                                                    Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="원문" />
                                <DataGridTextColumn Width="*"
                                                    Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="치환 번역" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="현재 프로젝트 사전">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="{Binding ProjectScopeText}"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,10"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="{Binding ProjectDictionaryPath}"
                               TextWrapping="Wrap" />

                    <DockPanel Grid.Row="2"
                               IsEnabled="{Binding CanEditProjectDictionary}">
                        <StackPanel DockPanel.Dock="Top"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                            <Button Width="84"
                                    Margin="0,0,8,0"
                                    Click="AddProjectEntry_Click"
                                    Content="추가" />
                            <Button Width="84"
                                    Click="RemoveProjectEntry_Click"
                                    Content="삭제" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding ProjectEntries}"
                                  SelectedItem="{Binding SelectedProjectEntry, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Width="64"
                                                        Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                        Header="사용" />
                                <DataGridTextColumn Width="*"
                                                    Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="원문" />
                                <DataGridTextColumn Width="*"
                                                    Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="치환 번역" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="보호 문자">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="번역 요청 전에 보호 토큰으로 치환할 전각 특수문자 목록입니다. 텍스트박스에 있는 각 문자를 하나씩 보호합니다."
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1"
                               Margin="0,12,0,6"
                               Text="전각 특수문자" />

                    <TextBox Grid.Row="2"
                             MinHeight="28"
                             VerticalContentAlignment="Center"
                             Text="{Binding ProtectedFullWidthCharacters, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1">
            <TextBlock Text="{Binding SummaryText}" />
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="80"
                    Margin="0,0,12,0"
                    Click="Cancel_Click"
                    Content="취소" />
            <Button Width="80"
                    IsDefault="True"
                    Click="Save_Click"
                    Content="확인" />
        </StackPanel>
    </Grid>
</Window>

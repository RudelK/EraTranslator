<Window x:Class="EraTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:EraTranslator"
        mc:Ignorable="d"
        Title="{x:Static app:ApplicationInfo.WindowTitle}"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="760">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="프로젝트">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"
                               Text="게임 폴더" />
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Width="80"
                            Margin="0,0,8,8"
                            IsEnabled="{Binding CanBrowseDirectories}"
                            Click="BrowseGameDirectory_Click"
                            Content="찾아보기" />
                     <TextBox Grid.Row="0"
                              Grid.Column="2"
                              Margin="0,0,0,8"
                              IsEnabled="{Binding CanBrowseDirectories}"
                              Text="{Binding GameDirectory, UpdateSourceTrigger=LostFocus}" />

                    <Grid Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="0,0,8,8"
                                   VerticalAlignment="Center"
                                   Text="출력 폴더" />
                        <Button Grid.Column="1"
                                Width="80"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanBrowseDirectories}"
                                Click="BrowseOutputDirectory_Click"
                                Content="찾아보기" />
                         <TextBox Grid.Column="2"
                                  Margin="0,0,0,8"
                                  IsEnabled="{Binding CanBrowseDirectories}"
                                  Text="{Binding OutputDirectory, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="{Binding SaveModeSummary}"
                               TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="설정 / 상태">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">
                            <Button Width="110"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanStartActions}"
                                    Click="OpenTranslationSettings_Click"
                                    Content="번역 설정..." />
                            <Button Width="110"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanStartActions}"
                                    Click="OpenUserDictionary_Click"
                                    Content="사용자 사전..." />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="120"
                                HorizontalAlignment="Right"
                                IsEnabled="{Binding CanStartActions}"
                                Visibility="Collapsed"
                                Click="OpenTeamSettings_Click"
                                Content="팀 작업 설정..." />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="{Binding TranslationSettingsSummary}"
                               TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2"
                                Margin="0,8,0,0">
                        <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Text="{Binding UserDictionarySummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Text="{Binding SummaryText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Visibility="Collapsed"
                               Text="{Binding TeamStatusSummary}"
                               TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="4" Header="작업">
                <Grid Margin="8">
                    <WrapPanel>
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanStartActions}"
                                Click="Scan_Click"
                                Content="텍스트 추출" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanStartActions}"
                                Click="ConvertEncoding_Click"
                                Content="인코딩 변환" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanStartActions}"
                                Click="Translate_Click"
                                Content="번역 시작" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanStartActions}"
                                Click="Save_Click"
                                Content="결과 저장" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanStartActions}"
                                Click="ExportTranslationsText_Click"
                                Content="텍스트 내보내기" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanStartActions}"
                                Click="ImportTranslationsText_Click"
                                Content="텍스트 가져오기" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanStartActions}"
                                Click="ResetTranslations_Click"
                                Content="번역 리셋" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanStartActions}"
                                Click="ResetExtraction_Click"
                                Content="추출 리셋" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanUseTeamActions}"
                                Visibility="Collapsed"
                                Click="TeamSync_Click"
                                Content="팀 동기화" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanUseTeamActions}"
                                Visibility="Collapsed"
                                Click="TeamManifestUpload_Click"
                                Content="Manifest 업로드" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanUseTeamActions}"
                                Visibility="Collapsed"
                                Click="TeamSubmit_Click"
                                Content="팀 제출" />
                        <Button Width="110"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanUseTeamActions}"
                                Visibility="Collapsed"
                                Click="TeamRetryQueue_Click"
                                Content="Queue 재전송" />
                        <Button Width="80"
                                Margin="0,0,0,8"
                                IsEnabled="{Binding CanCancel}"
                                Click="Cancel_Click"
                                Content="중지" />
                    </WrapPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="1" Margin="0,12,0,12" Header="필터">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0">
                    <ComboBox Width="110"
                              Margin="0,0,8,0"
                              IsEnabled="{Binding CanStartActions}"
                              ItemsSource="{Binding SearchFieldFilters}"
                              SelectedItem="{Binding SelectedSearchFieldFilter}" />
                    <TextBox Width="320"
                             Margin="0,0,8,0"
                             IsEnabled="{Binding CanStartActions}"
                             ToolTip="텍스트 또는 파일 경로 검색"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="120"
                              Margin="0,0,8,0"
                              IsEnabled="{Binding CanStartActions}"
                              ItemsSource="{Binding FileTypeFilters}"
                              SelectedItem="{Binding SelectedFileTypeFilter}" />
                    <ComboBox Width="120"
                              Margin="0,0,8,0"
                              IsEnabled="{Binding CanStartActions}"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}" />
                    <CheckBox Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding CanStartActions}"
                              Content="정규식"
                              IsChecked="{Binding UseRegexFilter}" />
                    <Button Width="108"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanStartActions}"
                            Click="OpenGlobalReplace_Click"
                            Content="전역 치환..." />
                    <CheckBox Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding CanStartActions}"
                              Content="경고만 보기"
                              IsChecked="{Binding WarningsOnly}" />
                    <CheckBox Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding CanStartActions}"
                              ToolTip="체크하면 번역문 수정 직후 현재 필터를 다시 적용합니다."
                              Content="실시간 갱신"
                              IsChecked="{Binding RefreshGridDuringTranslatedTextEdit}" />
                    <Button Width="72"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding CanStartActions}"
                            Click="RefreshFilter_Click"
                            Content="갱신" />
                </WrapPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="104"
                            Margin="8,0,8,0"
                            IsEnabled="{Binding CanStartActions}"
                            Click="ApplySameOriginalCorrection_Click"
                            Content="동일원문교정" />
                    <Button Width="92"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanStartActions}"
                            Click="ApplyJosaRewrite_Click"
                            Content="조사처리" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="TranslationGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CellEditEnding="TranslationGrid_CellEditEnding"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Width="72" Binding="{Binding FileType}" Header="종류" IsReadOnly="True" />
                <DataGridTextColumn Width="260" Binding="{Binding RelativePath}" Header="파일" IsReadOnly="True" />
                <DataGridTextColumn Width="70" Binding="{Binding LineNumber}" Header="줄" IsReadOnly="True" />
                <DataGridTextColumn Width="90" Binding="{Binding EncodingName}" Header="인코딩" IsReadOnly="True" />
                <DataGridTextColumn Width="120" Binding="{Binding SegmentType}" Header="추출 방식" IsReadOnly="True" />
                <DataGridTextColumn Width="120" Binding="{Binding ReferenceResolutionStatus}" Header="참조 상태" IsReadOnly="True" />
                <DataGridTextColumn Width="*" Binding="{Binding OriginalText}" Header="원문" IsReadOnly="True" />
                <DataGridTextColumn Width="*" Header="번역문">
                    <DataGridTextColumn.Binding>
                        <Binding Path="TranslatedText"
                                 Mode="TwoWay"
                                 UpdateSourceTrigger="LostFocus" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="160" Header="상태">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.EditableStatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding EditableStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="3" Margin="0,12,0,0" Header="선택 항목 보기">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="원문" />
                <TextBox Grid.Row="1"
                         Margin="0,6,0,12"
                         MinHeight="44"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Text="{Binding SelectedItemOriginalPreviewText, Mode=OneWay}" />

                <TextBlock Grid.Row="2" Text="번역문" />
                <TextBox Grid.Row="3"
                         Margin="0,6,0,0"
                         MinHeight="44"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         TextChanged="SelectedTranslationEditor_TextChanged"
                         LostFocus="SelectedTranslationEditor_LostFocus"
                         Text="{Binding SelectedItemTranslatedTextEditor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Margin="0,12,0,0" Header="선택 항목 로그">
            <TextBox Margin="8"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     MinLines="3"
                     MaxLines="3"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     TextWrapping="Wrap"
                     Text="{Binding SelectedItemLogText, Mode=OneWay}" />
        </GroupBox>

        <StatusBar Grid.Row="5" Margin="0,12,0,0">
            <StatusBarItem>
                <ProgressBar Width="220"
                             Height="16"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding ProgressValue}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentOperationDetail}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

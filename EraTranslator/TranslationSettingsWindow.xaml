<Window x:Class="EraTranslator.TranslationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="번역 설정"
        Width="640"
        Height="700"
        MinWidth="560"
        MinHeight="600"
        ResizeMode="CanResize"
        PreviewKeyDown="TranslationSettingsWindow_OnPreviewKeyDown"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="연결">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="공급자" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="번역 공급자" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding ProviderOptions}"
                                      SelectedItem="{Binding SelectedProviderOption}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Margin="6,0,0,0" Text="{Binding AvailabilityText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="기본 URL" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     Margin="0,0,0,8"
                                     Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="모델" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="0,0,8,8"
                                      IsEditable="True"
                                      IsEnabled="{Binding CanEditModel}"
                                      IsTextSearchEnabled="False"
                                      ItemsSource="{Binding AvailableModels}"
                                      Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="2"
                                    Grid.Column="2"
                                    Width="116"
                                    Margin="0,0,0,8"
                                    Click="LoadModels_Click"
                                    Content="모델 불러오기"
                                    IsEnabled="{Binding CanLoadModels}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="{Binding ProviderHelpText}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Margin="0,12,0,0"
                              Header="인증"
                              Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="API Key"
                                       Visibility="{Binding UsesApiKey, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <PasswordBox x:Name="ApiKeyPasswordBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="0,0,0,8"
                                         PasswordChanged="ApiKeyPasswordBox_OnPasswordChanged"
                                         Visibility="{Binding UsesApiKey, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Papago ID"
                                       Visibility="{Binding UsesPapagoCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding PapagoClientId, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding UsesPapagoCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="Papago Secret"
                                       Visibility="{Binding UsesPapagoCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <PasswordBox x:Name="PapagoSecretPasswordBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         PasswordChanged="PapagoSecretPasswordBox_OnPasswordChanged"
                                         Visibility="{Binding UsesPapagoCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="번역 옵션">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,8">
                            <Button Width="140"
                                    Click="ResetTranslationOptions_Click"
                                    Content="기본값으로 재설정" />
                        </StackPanel>

                        <GroupBox Grid.Row="1"
                                  Header="언어"
                                  Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="소스 언어" />
                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding SourceLanguage, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="대상 언어" />
                                <TextBox Grid.Row="0"
                                         Grid.Column="4"
                                         Text="{Binding TargetLanguage, UpdateSourceTrigger=PropertyChanged}" />

                                <CheckBox Grid.Row="1"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="5"
                                          Margin="0,10,0,0"
                                          Content="원문이 소스 언어가 아니면 자동 제외"
                                          IsChecked="{Binding ExcludeNonSourceText}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2"
                                  Margin="0,12,0,0"
                                  Header="공개 사전 선행 번역"
                                  Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Row="0"
                                          Grid.Column="0"
                                          Margin="0,0,0,8"
                                          Content="사전 exact match"
                                          IsChecked="{Binding EnableBundledDictionaryFirstPass}" />

                                <CheckBox Grid.Row="0"
                                          Grid.Column="2"
                                          Margin="0,0,0,8"
                                          Content="카타카나 음독"
                                          IsChecked="{Binding EnableKanaTransliterationFallback}" />

                                <CheckBox Grid.Row="1"
                                          Grid.Column="0"
                                          Margin="0,0,0,8"
                                          Content="네이버 일본어 사전"
                                          IsChecked="{Binding EnableNaverJapaneseDictionaryLookup}" />

                                <CheckBox Grid.Row="1"
                                          Grid.Column="2"
                                          Margin="0,0,0,8"
                                          Content="한자 음독"
                                          IsChecked="{Binding EnableKanjiReadingFallback}" />

                                <Grid Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,2,8,0"
                                               VerticalAlignment="Center"
                                               Text="최대 길이" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding DictionaryFirstMaxTermLength, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="옵션은 우선순위대로 동작합니다. exact match, 카타카나 음독, 네이버 사전, 한자 음독 순서이며 네이버 결과는 성공 시 로컬 네이버 사전에 저장됩니다."
                                           TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="3"
                                  Margin="0,12,0,0"
                                  Header="LLM Glossary"
                                  Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Row="0"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Margin="0,0,0,8"
                                          Content="현재 batch 관련 glossary 힌트 사용"
                                          IsChecked="{Binding EnableGlossaryHints}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,0,8,8"
                                           VerticalAlignment="Center"
                                           Text="최대 항목 수" />
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="0,0,0,8"
                                          IsEditable="True"
                                          ItemsSource="{Binding GlossaryMaxHintsOptions}"
                                          Text="{Binding GlossaryMaxHintsPerBatch, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Margin="0,0,8,8"
                                           VerticalAlignment="Center"
                                           Text="문자 예산" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          Margin="0,0,0,8"
                                          IsEditable="True"
                                          ItemsSource="{Binding GlossaryCharacterBudgetOptions}"
                                          Text="{Binding GlossaryCharacterBudget, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="최소 원문 길이" />
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          IsEditable="True"
                                          ItemsSource="{Binding GlossaryMinSourceLengthOptions}"
                                          Text="{Binding GlossaryMinSourceLength, UpdateSourceTrigger=PropertyChanged}" />

                                <CheckBox Grid.Row="4"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Margin="0,10,0,8"
                                          Content="탑재 일어사전 용어를 glossary 힌트로 사용"
                                          IsChecked="{Binding EnableBundledDictionaryGlossaryHints}" />

                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Margin="0,0,8,8"
                                           VerticalAlignment="Center"
                                           Text="사전 최대 항목" />
                                <ComboBox Grid.Row="5"
                                          Grid.Column="1"
                                          Margin="0,0,0,8"
                                          IsEditable="True"
                                          ItemsSource="{Binding BundledDictionaryGlossaryMaxHintsOptions}"
                                          Text="{Binding BundledDictionaryGlossaryMaxHintsPerBatch, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           Margin="0,0,8,8"
                                           VerticalAlignment="Center"
                                           Text="사전 문자 예산" />
                                <ComboBox Grid.Row="6"
                                          Grid.Column="1"
                                          Margin="0,0,0,8"
                                          IsEditable="True"
                                          ItemsSource="{Binding BundledDictionaryGlossaryCharacterBudgetOptions}"
                                          Text="{Binding BundledDictionaryGlossaryCharacterBudget, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="7"
                                           Grid.Column="0"
                                           Margin="0,0,8,8"
                                           VerticalAlignment="Center"
                                           Text="사전 최소 길이" />
                                <ComboBox Grid.Row="7"
                                          Grid.Column="1"
                                          Margin="0,0,0,8"
                                          IsEditable="True"
                                          ItemsSource="{Binding BundledDictionaryGlossaryMinTermLengthOptions}"
                                          Text="{Binding BundledDictionaryGlossaryMinTermLength, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="사전 최대 길이" />
                                <ComboBox Grid.Row="8"
                                          Grid.Column="1"
                                          IsEditable="True"
                                          ItemsSource="{Binding BundledDictionaryGlossaryMaxTermLengthOptions}"
                                          Text="{Binding BundledDictionaryGlossaryMaxTermLength, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="4"
                                  Margin="0,12,0,0"
                                  Header="배치 및 LLM"
                                  Padding="10">
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="동시 번역 줄 수" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding BatchSizeOptions}"
                                      SelectedItem="{Binding BatchSize}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="실패 재시도 횟수" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding RetryCountOptions}"
                                      SelectedItem="{Binding RetryCount}" />

                            <CheckBox Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,0,8"
                                      Content="Thinking 끄기"
                                      IsChecked="{Binding DisableThinking}"
                                      Visibility="{Binding SupportsThinkingToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="로컬 모델 프리셋"
                                       Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          Margin="0,0,8,0"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding LmStudioPresetOptions}"
                                          SelectedItem="{Binding SelectedLmStudioPresetOption}" />
                                <Button Grid.Column="1"
                                        Width="96"
                                        Click="ApplyLmStudioPreset_Click"
                                        Content="프리셋 적용" />
                            </Grid>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Temperature" />
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Top P"
                                       Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Row="5"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding TopPText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Top K"
                                       Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Row="6"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding TopKText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="7"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Repeat Penalty"
                                       Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Row="7"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding RepeatPenaltyText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Presence Penalty"
                                       Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Row="8"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding PresencePenaltyText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="9"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Seed"
                                       Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Row="9"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="10"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Max Tokens"
                                       Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Row="10"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding MaxTokensText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding SupportsAdvancedSampling, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="11"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="배치 크기를 줄이면 응답 오류를 줄이는 데 도움이 됩니다. 로컬 모델 프리셋은 Ollama, LM Studio, Lemonade에서 공통으로 사용하며, 자동(모델 기준), Gemma 4, Gemma 4 E4B, Qwen 3.5 9B, TranslateGemma, Hy-MT2 7B, Hy-MT2 30B-A3B 중에서 고를 수 있습니다. 프리셋 적용을 누르면 샘플링 권장값이 즉시 반영됩니다. Qwen 계열은 모델별 preset과 max_tokens 안전장치를 함께 사용하며, Max Tokens를 비워두면 요청 크기에 맞춰 자동 계산합니다. Hy-MT2 30B-A3B는 모델 카드 권장값으로 Top K에 -1을 사용할 수 있습니다."
                                       TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="EzTransXP">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="설치 상태" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="설치 경로" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="0,0,8,8"
                                     Text="{Binding EzTransInstallationPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Width="84"
                                    Margin="0,0,0,8"
                                    Click="RefreshEzTransStatus_Click"
                                    Content="다시 확인" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Top"
                                       Text="설치 판정" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,0,0,8"
                                       Text="{Binding EzTransStatusText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Top"
                                       Text="엔진 상세" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding EzTransEngineText}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Margin="0,12,0,0"
                              Header="워커 프로세스"
                              Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="동시 실행 개수" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding EzTransProcessCountOptions}"
                                      SelectedItem="{Binding EzTransProcessCount}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="EzTransXP 전용 워커 하위 프로세스를 여러 개 띄워 병렬 번역합니다. EzTransXP를 사용할 때는 배치 크기가 워커 수보다 작지 않도록 자동 보정됩니다."
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>

                    <TextBlock Grid.Row="2"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="기본 경로를 비워두면 레지스트리의 ChangShin\\ezTrans 경로를 우선 사용합니다. 포터블 설치본이면 직접 폴더 경로를 지정하세요."
                               TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="프롬프트">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Width="120"
                                   Margin="0,4,8,0"
                                   VerticalAlignment="Center"
                                   Text="프롬프트 프로필" />
                        <ComboBox Width="220"
                                  Margin="0,0,12,0"
                                  ItemsSource="{Binding PromptProfiles}"
                                  SelectedItem="{Binding SelectedPromptProfile}" />
                        <Button Width="140"
                                Click="ResetPrompts_Click"
                                Content="기본값으로 재설정" />
                        <TextBlock Margin="12,2,0,0"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Text="사용 가능한 치환값: {sourceLanguage}, {targetLanguage}, {thinkingInstruction}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="{Binding PromptProfileStatusText}"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1"
                               Margin="0,22,0,8"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="자동은 현재 모델명을 기준으로 프롬프트 프로필을 고릅니다. Gemma 4 E4B는 짧은 용어/라벨 정확도에 맞춘 전용 규칙을 사용하고, Hy-MT2는 전용 프롬프트 규칙과 glossary 형식을 사용합니다. TranslateGemma는 전용 LM Studio 요청 형식을 사용하므로 여기서 고른 프롬프트가 실제 요청에는 적용되지 않습니다."
                               TextWrapping="Wrap" />

                    <GroupBox Grid.Row="2"
                              Header="기본 프롬프트"
                              Padding="10">
                        <TextBox AcceptsReturn="True"
                                 Text="{Binding SystemPromptTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </GroupBox>

                    <GroupBox Grid.Row="3"
                              Margin="0,12,0,0"
                              Header="재시도 프롬프트"
                              Padding="10">
                        <TextBox AcceptsReturn="True"
                                 Text="{Binding RetryPromptTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="기타">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Header="로깅" Padding="10">
                            <StackPanel>
                                <CheckBox Margin="0,0,0,8"
                                          Content="실행 로그 파일 기록"
                                          IsChecked="{Binding EnableRequestResponseLogging}" />

                                <TextBlock Margin="0,0,0,8"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding RequestResponseLogPath}"
                                           TextWrapping="Wrap" />

                                <CheckBox Margin="0,0,0,8"
                                          Content="결과 로그 파일 기록"
                                          IsChecked="{Binding EnableResultStateLogging}" />

                                <TextBlock Margin="0,0,0,8"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding ResultStateLogPath}"
                                           TextWrapping="Wrap" />

                                <CheckBox Margin="0,0,0,8"
                                          Content="사전 히트 내역 기록"
                                          IsChecked="{Binding EnableDictionaryHitLogging}" />

                                <TextBlock Margin="0,0,0,8"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding DictionaryHitLogPath}"
                                           TextWrapping="Wrap" />

                                <CheckBox Margin="0,0,0,8"
                                          Content="성능 디버그 로그 기록"
                                          IsChecked="{Binding EnablePerformanceDebugLogging}" />

                                <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding PerformanceDebugLogPath}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Grid.Row="1"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Text="기본값은 꺼짐입니다. 실행 로그는 API 요청/응답을, 결과 로그는 저장 원인을, 사전 히트 로그는 사전/음독 선행 적용 내역을, 성능 디버그 로그는 번역 시작 전 병목 후보를 추적합니다."
                                   TextWrapping="Wrap" />

                        <GroupBox Grid.Row="2"
                                  Margin="0,12,0,0"
                                  Header="사전 출처 / 라이선스"
                                  Padding="10">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding BundledDictionarySnapshotText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding BundledDictionaryAttributionText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding BundledDictionaryNoticePath}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1">
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="80"
                    Margin="0,0,12,0"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Content="취소" />
            <Button Width="80"
                    IsDefault="True"
                    Click="Save_Click"
                    Content="확인" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="EraTranslator.TranslationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="번역 설정"
        Width="640"
        Height="700"
        MinWidth="560"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="연결">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="공급자" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="번역 공급자" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding ProviderOptions}"
                                      SelectedItem="{Binding SelectedProviderOption}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Margin="6,0,0,0" Text="{Binding AvailabilityText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="기본 URL" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     Margin="0,0,0,8"
                                     Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="모델" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="0,0,8,8"
                                      IsEditable="True"
                                      IsEnabled="{Binding SupportsModelCatalog}"
                                      IsTextSearchEnabled="False"
                                      ItemsSource="{Binding AvailableModels}"
                                      Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="2"
                                    Grid.Column="2"
                                    Width="116"
                                    Margin="0,0,0,8"
                                    Click="LoadModels_Click"
                                    Content="모델 불러오기"
                                    IsEnabled="{Binding CanLoadModels}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="{Binding ProviderHelpText}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Margin="0,12,0,0"
                              Header="인증"
                              Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="API Key"
                                       Visibility="{Binding UsesApiKey, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <PasswordBox x:Name="ApiKeyPasswordBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="0,0,0,8"
                                         PasswordChanged="ApiKeyPasswordBox_OnPasswordChanged"
                                         Visibility="{Binding UsesApiKey, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Papago ID"
                                       Visibility="{Binding UsesPapagoCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding PapagoClientId, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding UsesPapagoCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="Papago Secret"
                                       Visibility="{Binding UsesPapagoCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <PasswordBox x:Name="PapagoSecretPasswordBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         PasswordChanged="PapagoSecretPasswordBox_OnPasswordChanged"
                                         Visibility="{Binding UsesPapagoCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="번역 옵션">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="언어" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="소스 언어" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding SourceLanguage, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="3"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="대상 언어" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="4"
                                     Text="{Binding TargetLanguage, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="5"
                                      Margin="0,10,0,0"
                                      Content="원문이 소스 언어가 아니면 자동 제외"
                                      IsChecked="{Binding ExcludeNonSourceText}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Margin="0,12,0,0"
                              Header="배치 및 LLM"
                              Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="동시 번역 줄 수" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding BatchSizeOptions}"
                                      SelectedItem="{Binding BatchSize}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="실패 재시도 횟수" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding RetryCountOptions}"
                                      SelectedItem="{Binding RetryCount}" />

                            <CheckBox Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,0,8"
                                      Content="Thinking 끄기"
                                      IsChecked="{Binding DisableThinking}"
                                      Visibility="{Binding SupportsThinkingToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="Temperature" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="배치 크기를 줄이면 응답 오류를 줄이는 데 도움이 됩니다. 재시도 횟수는 실패한 항목만 다시 시도합니다. Temperature 기본값은 0.3입니다. Thinking 끄기는 OpenAI/LM Studio에서 추론 텍스트와 &lt;think&gt; 출력 억제를 시도합니다."
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="EzTransXP">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="설치 상태" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="설치 경로" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="0,0,8,8"
                                     Text="{Binding EzTransInstallationPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Width="84"
                                    Margin="0,0,0,8"
                                    Click="RefreshEzTransStatus_Click"
                                    Content="다시 확인" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Top"
                                       Text="설치 판정" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,0,0,8"
                                       Text="{Binding EzTransStatusText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Top"
                                       Text="엔진 상세" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding EzTransEngineText}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Margin="0,12,0,0"
                              Header="워커 프로세스"
                              Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="동시 실행 개수" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding EzTransProcessCountOptions}"
                                      SelectedItem="{Binding EzTransProcessCount}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="EzTransXP 전용 워커 하위 프로세스를 여러 개 띄워 병렬 번역합니다. EzTransXP를 사용할 때는 배치 크기가 워커 수보다 작지 않도록 자동 보정됩니다."
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>

                    <TextBlock Grid.Row="2"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="기본 경로를 비워두면 레지스트리의 ChangShin\\ezTrans 경로를 우선 사용합니다. 포터블 설치본이면 직접 폴더 경로를 지정하세요."
                               TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="프롬프트">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button Width="110"
                                Click="ResetPrompts_Click"
                                Content="기본값 복원" />
                        <TextBlock Margin="12,2,0,0"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Text="사용 가능한 치환값: {targetLanguage}, {thinkingInstruction}" />
                    </StackPanel>

                    <GroupBox Grid.Row="1"
                              Header="기본 프롬프트"
                              Padding="10">
                        <TextBox AcceptsReturn="True"
                                 Text="{Binding SystemPromptTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </GroupBox>

                    <GroupBox Grid.Row="2"
                              Margin="0,12,0,0"
                              Header="재시도 프롬프트"
                              Padding="10">
                        <TextBox AcceptsReturn="True"
                                 Text="{Binding RetryPromptTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="기타">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="로깅" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0"
                                      Margin="0,0,0,8"
                                      Content="실행 로그 파일 기록"
                                      IsChecked="{Binding EnableRequestResponseLogging}" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="{Binding RequestResponseLogPath}"
                                       TextWrapping="Wrap" />

                            <CheckBox Grid.Row="2"
                                      Margin="0,0,0,8"
                                      Content="결과 로그 파일 기록"
                                      IsChecked="{Binding EnableResultStateLogging}" />

                            <TextBlock Grid.Row="3"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="{Binding ResultStateLogPath}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>

                    <TextBlock Grid.Row="1"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="기본값은 꺼짐입니다. 실행 로그는 API 요청/응답을, 결과 로그는 결과 저장과 translation-progress 저장 원인을 추적합니다."
                               TextWrapping="Wrap" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1">
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="80"
                    Margin="0,0,12,0"
                    Click="Cancel_Click"
                    Content="취소" />
            <Button Width="80"
                    IsDefault="True"
                    Click="Save_Click"
                    Content="확인" />
        </StackPanel>
    </Grid>
</Window>

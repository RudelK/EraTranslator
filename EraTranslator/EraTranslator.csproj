<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>0.7.3</Version>
    <AssemblyVersion>0.7.3.0</AssemblyVersion>
    <FileVersion>0.7.3.0</FileVersion>
    <InformationalVersion>0.7.3</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\ZNAME.ERB">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\ZNAME.ERH">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Dictionaries\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EraTranslator.EzTransWorker\EraTranslator.EzTransWorker.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyEzTransWorkerToInternalFolder" AfterTargets="Build">
    <ItemGroup>
      <EzTransWorkerOutput Include="..\EraTranslator.EzTransWorker\bin\$(Configuration)\net8.0-windows\EraTranslator.EzTransWorker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(EzTransWorkerOutput)"
          DestinationFolder="$(OutDir)workers\EzTransXP\"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <EzTransWorkerRootOutput Include="$(OutDir)EraTranslator.EzTransWorker.*" />
    </ItemGroup>
    <Delete Files="@(EzTransWorkerRootOutput)" />
  </Target>

</Project>

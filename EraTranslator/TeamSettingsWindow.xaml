<Window x:Class="EraTranslator.TeamSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="팀 작업 설정"
        Width="620"
        Height="500"
        MinWidth="560"
        MinHeight="430"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="팀 작업" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,8,10"
                           VerticalAlignment="Center"
                           Text="작업 모드" />
                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                    <RadioButton Margin="0,0,16,0"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding IsLocalMode}"
                                 Content="로컬 작업" />
                    <RadioButton VerticalAlignment="Center"
                                 IsChecked="{Binding IsTeamMode}"
                                 Content="팀 작업" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="서버 URL" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,0,8"
                         IsEnabled="{Binding IsTeamMode}"
                         Text="{Binding TeamServerUrl, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="프로젝트 선택" />
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Orientation="Horizontal">
                    <Button Width="96"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanUseTeamActions}"
                            Click="RefreshTeamProjects_Click"
                            Content="목록 갱신" />
                    <ComboBox Width="320"
                              IsEnabled="{Binding CanUseTeamActions}"
                              ItemsSource="{Binding TeamProjects}"
                              SelectedItem="{Binding SelectedTeamProject}"
                              DisplayMemberPath="Name" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="프로젝트 ID" />
                <Grid Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             IsEnabled="{Binding CanEditTeamProjectId}"
                             Text="{Binding TeamProjectId, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding IsTeamMode}"
                              IsChecked="{Binding IsManualTeamProjectId}"
                              Content="수동 입력" />
                </Grid>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="표시명" />
                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Margin="0,0,0,8"
                         IsEnabled="{Binding IsTeamMode}"
                         Text="{Binding TeamDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="인증 토큰" />
                <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Margin="0,0,0,8"
                         IsEnabled="{Binding IsTeamMode}"
                         Text="{Binding TeamAuthToken, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="Workspace" />
                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Margin="0,0,0,8"
                         IsEnabled="{Binding IsTeamMode}"
                         Text="{Binding TeamWorkspaceRoot, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="ClientId" />
                <TextBox Grid.Row="7"
                         Grid.Column="1"
                         Margin="0,0,0,8"
                         IsEnabled="{Binding IsTeamMode}"
                         Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="{Binding TeamStatusSummary}"
                           TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1">
            <TextBlock Text="팀 작업 모드에서는 게임 폴더가 workspace/source, 출력 폴더가 workspace/output으로 자동 설정됩니다."
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    IsDefault="True"
                    Click="Close_Click"
                    Content="닫기" />
        </StackPanel>
    </Grid>
</Window>
